{
  "format": 2,
  "id": "sweep",
  "name": "Sweep",
  "description": "A band of colour travels across the room.",
  "author": "ha-hue-entertainment-streaming",
  "parameters": {
    "color": {"type": "color", "default": "#ff7a00"},
    "background": {"type": "color", "default": "#000000"},
    "width": {"type": "number", "default": 0.5, "min": 0.1, "max": 2},
    "period": {"type": "number", "default": 4, "min": 0.5, "max": 60},
    "axis": {"type": "choice", "default": "x", "options": ["x", "y", "z"]},
    "bounce": {"type": "choice", "default": false, "options": [false, true]}
  },
  "nodes": {
    "across": {"type": "oscillator", "shape": "saw",
      "rate": {"type": "divide", "a": 1, "b": "$period"}},
    "there_and_back": {"type": "oscillator", "shape": "triangle",
      "rate": {"type": "divide", "a": 0.5, "b": "$period"}},
    "centre": {"type": "remap", "to": [-1.2, 1.2],
      "input": {"type": "mix", "a": {"ref": "across"}, "b": {"ref": "there_and_back"}, "t": "$bounce"}},
    "distance": {"type": "abs",
      "input": {"type": "subtract", "a": {"type": "position", "axis": "$axis"}, "b": {"ref": "centre"}}}
  },
  "layers": [
    {"color": "$background"},
    {"color": "$color",
     "opacity": {"type": "smoothstep", "edge0": "$width", "edge1": 0, "input": {"ref": "distance"}}}
  ]
}
