{
  "format": 2,
  "id": "thunderstorm",
  "name": "Thunderstorm",
  "description": "Dim storm clouds with lightning that strikes somewhere and rolls across the room.",
  "author": "ha-hue-entertainment-streaming",
  "parameters": {
    "rate": {"type": "number", "default": 0.1, "min": 0, "max": 0.3}
  },
  "layers": [
    {"color": {"type": "map", "wrap": true,
       "colors": ["#05080f", "#101a2e", "#05080f"],
       "field": {"type": "noise", "scale": 1.0, "offset": {"type": "time", "speed": 0.03}}}},
    {"color": "#dfe8ff", "blend": "add",
     "opacity": {"type": "strikes", "rate": "$rate", "spread": 2.5, "decay": 0.3, "flicker": 3}}
  ]
}
