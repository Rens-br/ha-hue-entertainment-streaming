{
  "format": 2,
  "id": "aurora",
  "name": "Aurora",
  "description": "Slow green, teal and violet curtains drifting across the room.",
  "author": "ha-hue-entertainment-streaming",
  "parameters": {
    "drift": {"type": "number", "default": 0.05, "min": 0.01, "max": 0.5}
  },
  "layers": [
    {"color": {"type": "map", "wrap": true,
       "colors": ["#02140f", "#00c86e", "#00b4c8", "#5a28c8", "#02140f"],
       "field": {"type": "noise", "scale": 1.2, "offset": {"type": "time", "speed": "$drift"}}}}
  ]
}
